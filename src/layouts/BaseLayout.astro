---
import '@fontsource-variable/inter/opsz.css';
import '../styles/reset.css';
import '../styles/tokens.css';
import '../styles/global.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-opsz-normal.woff2?url';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import ogDefault from '../assets/og/og-default.png';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { href, site } from '../lib/site';

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  image?: ImageMetadata | undefined;
  type?: 'website' | 'article' | undefined;
  noindex?: boolean | undefined;
}

const {
  title,
  description = site.description,
  image,
  type = 'website',
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.role}`;
const siteUrl = Astro.site ?? new URL('https://vrayzix.github.io');
const canonical = new URL(Astro.url.pathname, siteUrl);
const ogSource = image && image.width >= 1200 && image.height >= 630 ? image : ogDefault;
const og = await getImage({ src: ogSource, width: 1200, height: 630, format: 'png' });
const ogUrl = new URL(og.src, siteUrl);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0f0f0f" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={href('sitemap-index.xml')} />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={type} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">
      Aller au contenu
    </a>
    <SiteHeader />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <button class="to-top" type="button" aria-label="Remonter en haut de la page" data-to-top>
      <svg
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m18 15-6-6-6 6" />
      </svg>
    </button>
  </body>
</html>

<script>
  const toTop = document.querySelector<HTMLButtonElement>('[data-to-top]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const onScroll = () => toTop?.classList.toggle('is-visible', window.scrollY > 500);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  toTop?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    document.querySelector<HTMLElement>('.navbar__logo')?.focus({ preventScroll: true });
  });

  const reveals = document.querySelectorAll<HTMLElement>('.reveal');
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
    );
    reveals.forEach((element) => observer.observe(element));
  } else {
    reveals.forEach((element) => element.classList.add('is-visible'));
  }
</script>

<style>
  .to-top {
    position: fixed;
    inset-block-end: var(--space-6);
    inset-inline-end: var(--space-6);
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgb(255 204 0 / 0.3);
    border-radius: 50%;
    background: rgb(255 204 0 / 0.15);
    color: var(--accent);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(20px);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    transition:
      opacity var(--dur) ease,
      visibility var(--dur) ease,
      transform var(--dur) ease,
      background-color var(--dur) ease,
      color var(--dur) ease,
      box-shadow var(--dur) ease;
  }

  .to-top.is-visible {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .to-top:hover {
    background: var(--accent);
    color: var(--on-accent);
    box-shadow: 0 10px 25px var(--accent-glow);
    transform: translateY(-3px);
  }

  @media (max-width: 480px) {
    .to-top {
      inset-block-end: var(--space-5);
      inset-inline-end: var(--space-5);
      width: 40px;
      height: 40px;
    }
  }
</style>
