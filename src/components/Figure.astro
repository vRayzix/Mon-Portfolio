---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string | undefined;
  narrow?: boolean | undefined;
  loading?: 'lazy' | 'eager' | undefined;
}

const { src, alt, caption, narrow = false, loading = 'lazy' } = Astro.props;
const widths = [480, 800, 1200, 1600].filter((w) => w <= src.width);
---

<figure class:list={['figure', { 'figure--narrow': narrow }]}>
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    widths={widths.length > 0 ? widths : [src.width]}
    sizes={narrow ? '(min-width: 810px) 26rem, 100vw' : '(min-width: 1280px) 58rem, 100vw'}
    loading={loading}
    decoding="async"
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin: 0;
  }

  .figure--narrow {
    max-width: 26rem;
  }

  .figure :global(img) {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-subtle);
  }

  figcaption {
    margin-block-start: var(--space-3);
    font-size: var(--step--1);
    color: var(--fg-muted);
  }
</style>
