---
const steps = [
  {
    title: 'Documenter pour que d’autres puissent refaire',
    text: 'Une installation n’est terminée que lorsqu’elle est écrite : procédure pas à pas, choix expliqués, versions notées.',
  },
  {
    title: 'Diagnostiquer couche par couche',
    text: 'Face à une panne, je remonte la pile dans l’ordre (service, port, proxy, journaux) au lieu de tester au hasard.',
  },
  {
    title: 'Exposer le strict nécessaire',
    text: 'Une seule entrée publique, des accès d’administration par clé, des flux internes dans un tunnel chiffré.',
  },
  {
    title: 'Superviser ce qui tourne',
    text: 'Métriques, tableaux de bord et journaux centralisés : un service en production doit pouvoir être observé.',
  },
];
---

<ol class="approach list-reset">
  {steps.map((step, i) => (
    <li>
      <span class="approach__num" aria-hidden="true">
        {String(i + 1).padStart(2, '0')}
      </span>
      <h3>{step.title}</h3>
      <p>{step.text}</p>
    </li>
  ))}
</ol>

<style>
  .approach {
    display: grid;
    gap: var(--space-7) var(--space-6);
  }

  @media (min-width: 810px) {
    .approach {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1280px) {
    .approach {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .approach li {
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--border);
  }

  .approach__num {
    display: block;
    margin-block-end: var(--space-5);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
    color: var(--accent);
  }

  .approach h3 {
    font-size: var(--step-1);
    max-width: 22ch;
  }

  .approach p {
    margin-block-start: var(--space-3);
    color: var(--fg-muted);
  }
</style>
