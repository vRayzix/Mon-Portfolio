---
import ProjectCard from './ProjectCard.astro';
import type { Project } from '../lib/projects';

interface Props {
  projects: Project[];
  headingLevel?: 'h2' | 'h3' | undefined;
}

const { projects, headingLevel = 'h3' } = Astro.props;
---

<div class="project-grid">
  {projects.map((project, index) => (
    <ProjectCard
      project={project}
      featured={project.id === 'homelab'}
      headingLevel={headingLevel}
      eager={index === 0}
    />
  ))}
</div>

<style>
  .project-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: 68.75rem;
    margin-inline: auto;
  }
</style>
