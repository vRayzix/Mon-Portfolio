---
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<defs>
  <marker
    id={id}
    viewBox="0 0 10 10"
    refX="9"
    refY="5"
    markerWidth="7"
    markerHeight="7"
    orient="auto-start-reverse"
  >
    <path class="dg-arrow" d="M0 0 L10 5 L0 10 z"></path>
  </marker>
</defs>
