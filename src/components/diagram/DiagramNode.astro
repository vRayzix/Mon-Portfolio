---
interface Props {
  x: number;
  y: number;
  w: number;
  h: number;
  label: string;
  sub?: string;
  variant?: 'default' | 'accent' | 'muted';
}

const { x, y, w, h, label, sub, variant = 'default' } = Astro.props;
const cx = x + w / 2;
const cy = y + h / 2;
---

<g class:list={['dg-node', variant !== 'default' && `dg-node--${variant}`]}>
  <rect x={x} y={y} width={w} height={h} rx="5"></rect>
  <text class="dg-label" x={cx} y={sub ? cy - 3 : cy + 5} text-anchor="middle">
    {label}
  </text>
  {sub && (
    <text class="dg-sub" x={cx} y={cy + 14} text-anchor="middle">
      {sub}
    </text>
  )}
</g>
