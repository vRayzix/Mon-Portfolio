---
const groups = [
  {
    name: 'Systèmes',
    icon: 'server',
    items: [
      'Debian',
      'Ubuntu Server',
      'systemd',
      'Nginx',
      'Caddy',
      'Gunicorn',
      'MariaDB',
      'Docker',
      'Windows Server',
      'Active Directory',
    ],
  },
  {
    name: 'Réseau',
    icon: 'network',
    items: [
      'Cisco IOS',
      'VLAN 802.1Q',
      'OSPF',
      'RIP',
      'NAT',
      'DHCP',
      'ACL',
      '802.1X et RADIUS',
      'WireGuard',
      'pfSense',
      'iptables',
      'GNS3',
      'EVE-NG',
    ],
  },
  {
    name: 'Supervision et sécurité',
    icon: 'shield',
    items: [
      'Prometheus',
      'Grafana',
      'Node Exporter',
      'Wazuh',
      'OpenSearch',
      'CrowdSec',
      'Lynis',
      'TLS et ACME',
      'Vaultwarden',
    ],
  },
  {
    name: 'Outils et méthode',
    icon: 'code',
    items: [
      'Git',
      'GitHub',
      'Python',
      'Bash',
      'PowerShell',
      'ServiceNow',
      'Markdown',
      'C++ Arduino',
      'MQTT',
      'Flutter',
    ],
  },
] as const;

const copies = [0, 1, 2, 3];
---

<div class="skills">
  <div class="visually-hidden">
    {groups.map((group) => (
      <>
        <h3>{group.name}</h3>
        <ul>
          {group.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </>
    ))}
  </div>
  <div class="marquee" aria-hidden="true">
    {groups.map((group, index) => (
      <div class:list={['marquee__row', index % 2 === 0 ? 'to-left' : 'to-right']}>
        <div class="marquee__track" style={`--duration: ${[48, 55, 45, 52][index]}s`}>
          {copies.map((copy) => (
            <div class:list={['marquee__set', { 'marquee__set--clone': copy > 0 }]}>
              {group.items.map((item) => (
                <span class="skill">
                  <svg
                    class="skill__icon"
                    viewBox="0 0 24 24"
                    width="18"
                    height="18"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    {group.icon === 'server' && (
                      <>
                        <rect x="3" y="4" width="18" height="7" rx="1.5" />
                        <rect x="3" y="13" width="18" height="7" rx="1.5" />
                        <path d="M7 7.5h.01M7 16.5h.01" />
                      </>
                    )}
                    {group.icon === 'network' && (
                      <>
                        <rect x="9" y="3" width="6" height="5" rx="1" />
                        <rect x="3" y="16" width="6" height="5" rx="1" />
                        <rect x="15" y="16" width="6" height="5" rx="1" />
                        <path d="M12 8v4M6 16v-4h12v4" />
                      </>
                    )}
                    {group.icon === 'shield' && (
                      <>
                        <path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.3 7.5 9.5 4.3-1.2 7.5-4.9 7.5-9.5V6L12 3Z" />
                        <path d="m9 12 2 2 4-4" />
                      </>
                    )}
                    {group.icon === 'code' && <path d="m8 7-5 5 5 5M16 7l5 5-5 5M14 4l-4 16" />}
                  </svg>
                  <span class="skill__name">{item}</span>
                </span>
              ))}
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .marquee {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    width: 100%;
    padding-block: var(--space-5);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent);
  }

  .marquee__track {
    display: flex;
    width: max-content;
  }

  .marquee__set {
    display: flex;
    gap: var(--space-5);
    padding-inline-end: var(--space-5);
  }

  .skill {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.8rem 1.5rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--surface);
    white-space: nowrap;
    transition:
      background-color var(--dur) ease,
      border-color var(--dur) ease,
      transform var(--dur) ease,
      box-shadow var(--dur) ease;
  }

  .skill:hover {
    border-color: var(--accent);
    background: #252525;
    box-shadow: 0 4px 12px rgb(255 204 0 / 0.15);
    transform: translateY(-3px);
  }

  .skill__icon {
    flex-shrink: 0;
    color: var(--accent);
    transition: transform var(--dur) ease;
  }

  .skill:hover .skill__icon {
    transform: scale(1.1);
  }

  .skill__name {
    color: var(--fg-muted);
    font-size: 0.85rem;
    font-weight: var(--weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: color var(--dur) ease;
  }

  .skill:hover .skill__name {
    color: var(--fg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .to-left .marquee__track {
      animation: marquee-left var(--duration) linear infinite;
    }

    .to-right .marquee__track {
      animation: marquee-right var(--duration) linear infinite;
    }

    .marquee__track:hover {
      animation-play-state: paused;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee {
      -webkit-mask-image: none;
      mask-image: none;
    }

    .marquee__track {
      width: 100%;
    }

    .marquee__set {
      flex-wrap: wrap;
      justify-content: center;
      padding: 0;
    }

    .marquee__set--clone {
      display: none;
    }
  }

  @keyframes marquee-left {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-25%);
    }
  }

  @keyframes marquee-right {
    from {
      transform: translateX(-25%);
    }

    to {
      transform: translateX(0);
    }
  }

  @media (max-width: 768px) {
    .marquee {
      gap: var(--space-4);
    }

    .marquee__set {
      gap: var(--space-4);
      padding-inline-end: var(--space-4);
    }

    .skill {
      padding: 0.6rem 1.2rem;
    }
  }

  @media (max-width: 480px) {
    .skill {
      gap: 0.5rem;
      padding: 0.5rem 1rem;
    }

    .skill__name {
      font-size: 0.75rem;
    }
  }
</style>
