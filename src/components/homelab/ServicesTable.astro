---
interface Service {
  name: string;
  role: string;
  host: 'VPS' | 'VM de lab';
  version?: string;
  exposure: string;
}

const services: Service[] = [
  {
    name: 'Caddy',
    role: 'Reverse proxy, certificats TLS automatiques',
    host: 'VPS',
    exposure: 'Public, HTTPS uniquement',
  },
  { name: 'Site statique', role: 'Page web publique', host: 'VPS', exposure: 'Via Caddy' },
  { name: 'Grafana', role: 'Tableaux de bord de supervision', host: 'VPS', exposure: 'Via Caddy' },
  {
    name: 'Vaultwarden',
    role: 'Gestionnaire de secrets auto-hébergé',
    host: 'VPS',
    exposure: 'Via Caddy',
  },
  {
    name: 'Prometheus',
    role: 'Collecte et stockage des métriques',
    host: 'VPS',
    exposure: 'Hors reverse proxy',
  },
  {
    name: 'Node Exporter',
    role: 'Métriques système du VPS',
    host: 'VPS',
    exposure: 'Hors reverse proxy',
  },
  {
    name: 'CrowdSec',
    role: 'Détection d’intrusion, blocage via iptables',
    host: 'VPS',
    exposure: 'Local',
  },
  {
    name: 'Agent Wazuh',
    role: 'Remontée des journaux vers le SIEM',
    host: 'VPS',
    exposure: 'Sortant, par le tunnel',
  },
  {
    name: 'WireGuard',
    role: 'Tunnel chiffré entre le VPS et la VM',
    host: 'VPS',
    exposure: 'UDP, extrémité publique du tunnel',
  },
  {
    name: 'OpenSSH',
    role: 'Administration',
    host: 'VPS',
    exposure: 'Clé uniquement, port non standard',
  },
  {
    name: 'Wazuh Manager',
    role: 'Réception des agents, corrélation, alertes',
    host: 'VM de lab',
    exposure: 'Tunnel et réseau du lab',
  },
  {
    name: 'Indexeur OpenSearch',
    role: 'Stockage et recherche des événements',
    host: 'VM de lab',
    exposure: 'Réseau du lab',
  },
  {
    name: 'Wazuh Dashboard',
    role: 'Interface d’analyse du SIEM',
    host: 'VM de lab',
    exposure: 'Réseau du lab',
  },
  {
    name: 'WireGuard',
    role: 'Extrémité du tunnel côté lab',
    host: 'VM de lab',
    exposure: 'Tunnel',
  },
];
---

<div class="table-scroll">
  <table class="data-table">
    <caption class="visually-hidden">
      Services du homelab : rôle, hôte, version et exposition
    </caption>
    <thead>
      <tr>
        <th scope="col">Service</th>
        <th scope="col">Rôle</th>
        <th scope="col">Hôte</th>
        <th scope="col">Version</th>
        <th scope="col">Exposition</th>
      </tr>
    </thead>
    <tbody>
      {services.map((s) => (
        <tr>
          <td>{s.name}</td>
          <td>{s.role}</td>
          <td>{s.host}</td>
          <td>
            {s.version ?? (
              <>
                <span aria-hidden="true">—</span>
                <span class="visually-hidden">non renseignée</span>
              </>
            )}
          </td>
          <td>{s.exposure}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .data-table {
    min-width: 44rem;
  }
</style>
