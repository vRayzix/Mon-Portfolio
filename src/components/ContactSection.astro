---
import { href, site } from '../lib/site';

const details = [
  { label: 'E-mail', value: site.email, url: `mailto:${site.email}`, icon: 'mail' },
  { label: 'Localisation', value: site.location, icon: 'pin' },
  { label: 'Disponibilité', value: 'Stage de 9 semaines, avril à juin 2027', icon: 'calendar' },
] as const;

const socials = [
  { label: 'LinkedIn', url: site.linkedin },
  { label: 'GitHub', url: site.github },
  { label: 'BeatStars', url: site.beatstars },
];
---

<div class="contact">
  <div class="contact__card glass reveal">
    <h3 class="contact__card-title">Un stage à proposer&nbsp;?</h3>
    <p class="contact__lead">
      Une offre, une question sur un projet ou simplement un échange&nbsp;: écrivez-moi directement,
      je réponds rapidement.
    </p>
    <div class="contact__actions">
      <a class="btn btn--primary" href={`mailto:${site.email}`}>
        M’écrire un e-mail
      </a>
      <a class="btn btn--secondary" href={href(site.cv)}>
        Télécharger mon CV
      </a>
    </div>
  </div>

  <div class="contact__card glass reveal">
    <h3 class="contact__card-title">Mes coordonnées</h3>
    <ul class="contact__details list-reset">
      {details.map((item) => {
        const Tag = 'url' in item ? 'a' : 'div';
        return (
          <li>
            <Tag
              class:list={['detail', { 'detail--static': !('url' in item) }]}
              href={'url' in item ? item.url : undefined}
            >
              <span class="detail__icon" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  width="22"
                  height="22"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  {item.icon === 'mail' && (
                    <>
                      <rect x="3" y="5" width="18" height="14" rx="2" />
                      <path d="m3 7 9 6 9-6" />
                    </>
                  )}
                  {item.icon === 'pin' && (
                    <>
                      <path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z" />
                      <circle cx="12" cy="9.5" r="2.5" />
                    </>
                  )}
                  {item.icon === 'calendar' && (
                    <>
                      <rect x="3" y="5" width="18" height="16" rx="2" />
                      <path d="M3 10h18M8 3v4M16 3v4" />
                    </>
                  )}
                </svg>
              </span>
              <span class="detail__content">
                <span class="detail__label">{item.label}</span>
                <span class="detail__value">{item.value}</span>
              </span>
            </Tag>
          </li>
        );
      })}
    </ul>
    <div class="contact__social">
      <p class="contact__social-label">Me retrouver</p>
      <ul class="contact__social-list list-reset">
        {socials.map((item) => (
          <li>
            <a class="pill" href={item.url}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>

<style>
  .contact {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
    align-items: stretch;
    max-width: 68.75rem;
    margin-inline: auto;
  }

  .contact__card {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
  }

  .contact__card-title {
    margin-block-end: var(--space-5);
    color: var(--accent);
    font-size: 1.3rem;
    letter-spacing: 0;
    text-align: center;
  }

  .contact__lead {
    flex: 1;
    color: var(--fg-muted);
    font-size: 1.05rem;
    line-height: 1.8;
    text-align: center;
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    margin-block-start: var(--space-6);
  }

  .contact__details {
    display: grid;
    gap: var(--space-4);
  }

  .detail {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) 1.2rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--bg-raised);
    text-decoration: none;
    transition:
      border-color var(--dur) ease,
      background-color var(--dur) ease,
      transform var(--dur) ease;
  }

  a.detail:hover {
    border-color: var(--accent);
    background: #333333;
    transform: translateX(5px);
  }

  .detail__icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius);
    background: linear-gradient(135deg, #ffcc00, #ff9500);
    color: var(--on-accent);
  }

  .detail__content {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .detail__label {
    color: #888888;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .detail__value {
    color: var(--fg);
    font-size: 0.95rem;
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .contact__social {
    margin-block-start: var(--space-5);
    padding-block-start: var(--space-5);
    border-block-start: 1px solid var(--border-strong);
  }

  .contact__social-label {
    margin-block-end: var(--space-4);
    color: #888888;
    font-size: 0.8rem;
    letter-spacing: 1.5px;
    text-align: center;
    text-transform: uppercase;
  }

  .contact__social-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
  }

  @media (max-width: 768px) {
    .contact {
      grid-template-columns: minmax(0, 1fr);
    }

    .contact__card {
      padding: var(--space-5);
    }

    a.detail:hover {
      transform: none;
    }
  }

  @media (max-width: 480px) {
    .contact__card {
      padding: 1.2rem;
      border-radius: 20px;
    }

    .contact__actions .btn {
      width: 100%;
    }

    .detail__icon {
      width: 40px;
      height: 40px;
    }
  }
</style>
