---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { href, site } from '../lib/site';

const roles = ['Étudiant en réseaux et télécoms', 'Futur administrateur systèmes et réseaux'];
const photos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/profil/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const photo = Object.values(photos)[0]?.default;
---

<section class="hero" id="home" aria-labelledby="hero-title">
  <canvas class="hero__particles" aria-hidden="true" data-particles></canvas>
  <div class="wrap hero__inner">
    <div class="hero__content">
      <p class="hero__greeting rise">Bonjour, je suis</p>
      <h1 class="hero__name rise rise-delay-1" id="hero-title">
        {site.name}
      </h1>
      <p class="hero__title rise rise-delay-2">
        <span class="visually-hidden">{roles.join(', ')}</span>
        <span class="typed" aria-hidden="true" data-typed={JSON.stringify(roles)}>
          <span class="typed__text">{roles[0]}</span>
          <span class="typed__cursor">|</span>
        </span>
      </p>
      <p class="hero__tagline rise rise-delay-2">
        Je cherche un stage de 9 semaines en administration systèmes et réseaux, d’avril à juin
        2027.
      </p>
      <div class="hero__cta rise rise-delay-3">
        <a class="btn btn--primary" href="#projets">
          Voir mes projets
        </a>
        <a class="btn btn--secondary" href={href(site.cv)}>
          Télécharger mon CV
        </a>
      </div>
    </div>

    {photo && (
      <div class="hero__visual rise rise-delay-1">
        <div class="electric">
          <svg class="electric__defs" aria-hidden="true" focusable="false">
            <defs>
              <filter
                id="electric-filter"
                color-interpolation-filters="sRGB"
                x="-25%"
                y="-25%"
                width="150%"
                height="150%"
              >
                <feTurbulence
                  type="fractalNoise"
                  baseFrequency="0.035"
                  numOctaves="3"
                  seed="1"
                  result="n1"
                >
                  <animate
                    attributeName="seed"
                    values="1;2;3;4;5;6;7;8"
                    dur="0.8s"
                    calcMode="discrete"
                    repeatCount="indefinite"
                  />
                </feTurbulence>
                <feOffset in="n1" dx="0" dy="0" result="o1">
                  <animate
                    attributeName="dy"
                    values="-40;40;-40"
                    dur="5s"
                    repeatCount="indefinite"
                  />
                  <animate
                    attributeName="dx"
                    values="30;-30;30"
                    dur="7s"
                    repeatCount="indefinite"
                  />
                </feOffset>
                <feDisplacementMap
                  in="SourceGraphic"
                  in2="o1"
                  scale="16"
                  xChannelSelector="R"
                  yChannelSelector="G"
                />
              </filter>
            </defs>
          </svg>
          <div class="electric__border" aria-hidden="true"></div>
          <div class="electric__glow electric__glow--1" aria-hidden="true"></div>
          <div class="electric__glow electric__glow--2" aria-hidden="true"></div>
          <div class="electric__bg" aria-hidden="true"></div>
          <div class="profile">
            <Picture
              src={photo}
              alt={`Portrait de ${site.name}`}
              formats={['avif', 'webp']}
              widths={[350, 700]}
              sizes="(max-width: 480px) 200px, (max-width: 968px) 250px, 350px"
              loading="eager"
            />
          </div>
        </div>
      </div>
    )}
  </div>
</section>

<script>
  const typed = document.querySelector<HTMLElement>('[data-typed]');
  const text = typed?.querySelector<HTMLElement>('.typed__text');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (typed && text && !reduce) {
    const roles = JSON.parse(typed.dataset.typed ?? '[]') as string[];
    let role = 0;
    let length = roles[0]?.length ?? 0;
    let deleting = true;
    const tick = () => {
      const current = roles[role] ?? '';
      if (deleting) {
        length -= 1;
        text.textContent = current.slice(0, Math.max(length, 0));
        if (length <= 0) {
          deleting = false;
          role = (role + 1) % roles.length;
          return window.setTimeout(tick, 400);
        }
        return window.setTimeout(tick, 35);
      }
      const next = roles[role] ?? '';
      length += 1;
      text.textContent = next.slice(0, length);
      if (length >= next.length) {
        deleting = true;
        return window.setTimeout(tick, 2200);
      }
      return window.setTimeout(tick, 70);
    };
    window.setTimeout(tick, 2600);
  }

  const canvas = document.querySelector<HTMLCanvasElement>('[data-particles]');
  const context = canvas?.getContext('2d');

  if (canvas && context && !reduce) {
    type Dot = { x: number; y: number; vx: number; vy: number; r: number; gold: boolean };
    let dots: Dot[] = [];
    let width = 0;
    let height = 0;
    let frame = 0;
    let running = false;
    const pointer = { x: -9999, y: -9999 };

    const resize = () => {
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      width = canvas.clientWidth;
      height = canvas.clientHeight;
      canvas.width = width * ratio;
      canvas.height = height * ratio;
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      const count = Math.round(Math.min(90, (width * height) / 16000));
      dots = Array.from({ length: count }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.25,
        vy: (Math.random() - 0.5) * 0.25,
        r: Math.random() * 1.6 + 0.4,
        gold: Math.random() < 0.35,
      }));
    };

    const draw = () => {
      context.clearRect(0, 0, width, height);
      for (const dot of dots) {
        dot.x += dot.vx;
        dot.y += dot.vy;
        if (dot.x < 0 || dot.x > width) dot.vx *= -1;
        if (dot.y < 0 || dot.y > height) dot.vy *= -1;
        const dx = dot.x - pointer.x;
        const dy = dot.y - pointer.y;
        const distance = Math.hypot(dx, dy);
        const push = distance < 120 ? (120 - distance) / 120 : 0;
        context.beginPath();
        context.arc(dot.x + dx * push * 0.15, dot.y + dy * push * 0.15, dot.r, 0, Math.PI * 2);
        context.fillStyle = dot.gold ? 'rgba(255, 204, 0, 0.7)' : 'rgba(255, 255, 255, 0.35)';
        context.fill();
      }
      frame = requestAnimationFrame(draw);
    };

    const start = () => {
      if (running) return;
      running = true;
      frame = requestAnimationFrame(draw);
    };

    const stop = () => {
      running = false;
      cancelAnimationFrame(frame);
    };

    resize();
    window.addEventListener('resize', resize);
    canvas.parentElement?.addEventListener('pointermove', (event) => {
      const box = canvas.getBoundingClientRect();
      pointer.x = event.clientX - box.left;
      pointer.y = event.clientY - box.top;
    });
    canvas.parentElement?.addEventListener('pointerleave', () => {
      pointer.x = -9999;
      pointer.y = -9999;
    });
    new IntersectionObserver(([entry]) => (entry?.isIntersecting ? start() : stop())).observe(
      canvas,
    );
  }
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: calc(100svh - var(--nav-h));
    padding-block: var(--space-7);
    overflow: hidden;
    color: var(--fg);
  }

  .hero__particles {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  .hero__content {
    flex: 1;
    min-width: 0;
  }

  .hero__greeting {
    margin-block-end: var(--space-2);
    color: var(--accent);
    font-size: 1.5rem;
    font-weight: 500;
  }

  .hero__name {
    font-size: var(--step-4);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
  }

  .hero__title {
    min-height: 1.4em;
    margin-block: var(--space-2);
    font-size: clamp(1.3rem, 1rem + 1.4vw, 2rem);
    font-weight: 500;
    line-height: 1.4;
  }

  .typed__text {
    background: linear-gradient(90deg, #ffcc00, #ffffff, #ffcc00, #ffffff, #ffcc00);
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: gradient-flow 3s linear infinite;
  }

  .typed__cursor {
    display: inline-block;
    margin-inline-start: 0.25rem;
    color: var(--accent);
    animation: blink 1s steps(1) infinite;
  }

  @keyframes gradient-flow {
    from {
      background-position: 0% 50%;
    }

    to {
      background-position: 200% 50%;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .hero__tagline {
    max-width: 46ch;
    margin-block-start: var(--space-5);
    color: var(--fg-muted);
    font-size: 1.1rem;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-block-start: var(--space-6);
  }

  .hero__visual {
    flex-shrink: 0;
  }

  .electric {
    --size: 350px;
    position: relative;
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
  }

  .electric__defs {
    position: absolute;
    width: 0;
    height: 0;
  }

  .electric__border,
  .electric__glow,
  .electric__bg {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    pointer-events: none;
  }

  .electric__border {
    inset: -6px;
    border: 2px solid var(--accent);
    filter: url(#electric-filter);
    z-index: 2;
  }

  .electric__glow--1 {
    inset: -6px;
    border: 1px solid rgb(255 204 0 / 0.6);
    filter: blur(1px);
    z-index: 2;
  }

  .electric__glow--2 {
    inset: -6px;
    border: 1px solid #ffdf5c;
    filter: blur(4px);
    z-index: 2;
  }

  .electric__bg {
    z-index: 0;
    background: linear-gradient(-30deg, #ffdf5c, transparent, var(--accent));
    opacity: 0.3;
    filter: blur(32px);
    transform: scale(1.1);
  }

  .profile {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 50%;
    background:
      radial-gradient(circle at 30% 25%, rgb(255 204 0 / 0.18), transparent 55%),
      radial-gradient(rgb(255 255 255 / 0.08) 1px, transparent 1px) 0 0 / 14px 14px,
      #1a1a1a;
  }

  .profile :global(picture),
  .profile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (prefers-reduced-motion: reduce) {
    .electric__border {
      filter: none;
      box-shadow:
        0 0 8px var(--accent),
        0 0 16px rgb(255 204 0 / 0.5);
    }
  }

  @media (max-width: 968px) {
    .hero__inner {
      flex-direction: column-reverse;
      gap: var(--space-6);
      text-align: center;
    }

    .hero__tagline {
      margin-inline: auto;
    }

    .hero__cta {
      justify-content: center;
    }

    .electric {
      --size: 250px;
    }
  }

  @media (max-width: 480px) {
    .hero__greeting {
      font-size: 1.2rem;
    }

    .hero__tagline {
      font-size: 0.95rem;
    }

    .hero__cta {
      flex-direction: column;
      align-items: stretch;
    }

    .electric {
      --size: 200px;
    }
  }
</style>
