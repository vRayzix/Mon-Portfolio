---
import studio from '../assets/musique/studio.png';
import Figure from './Figure.astro';
import { site } from '../lib/site';

const points = [
  {
    term: 'Catalogue',
    text: 'Je développe et maintiens un catalogue de productions sur BeatStars.',
  },
  {
    term: 'Clients',
    text: 'Ventes à l’international, en anglais et en allemand, avec licences et contrats de droits d’auteur.',
  },
  {
    term: 'Technique',
    text: 'MAO avancée sous FL Studio et Cubase, gestion de flux audio et traitement du signal.',
  },
  {
    term: 'Diffusion',
    text: 'Promotion sur les réseaux sociais et analyse des statistiques de vente.',
  },
];
---

<div class="music glass reveal">
  <div class="music__text">
    <p class="music__lead">
      Je compose et produis de la musique en indépendant. Égaliser une piste ou lire un spectre,
      c’est du traitement du signal : le même que celui des télécoms, côté studio.
    </p>
    <dl class="music__points">
      {points.map((p) => (
        <div>
          <dt>{p.term}</dt>
          <dd>{p.text}</dd>
        </div>
      ))}
    </dl>
    <a class="btn btn--primary music__link" href={site.beatstars}>
      Écouter sur BeatStars
    </a>
  </div>
  <div class="music__visual">
    <Figure
      src={studio}
      alt="Session FL Studio : égaliseur FabFilter Pro-Q avec une légère bosse dans les aigus, au-dessus de la console de mixage et de ses bus kick, reverb, mélodies et drums."
      caption="Une session en cours : égalisation au Pro-Q et console de mixage."
    />
  </div>
</div>

<style>
  .music {
    display: grid;
    gap: var(--space-7);
    align-items: center;
    max-width: 68.75rem;
    margin-inline: auto;
    padding: var(--space-7);
    border-radius: var(--radius-xl);
  }

  @media (min-width: 1024px) {
    .music {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: var(--space-8);
    }
  }

  .music__lead {
    color: var(--fg-muted);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .music__points {
    display: grid;
    gap: var(--space-4);
    margin-block-start: var(--space-6);
  }

  .music__points div {
    position: relative;
    display: grid;
    gap: var(--space-1);
    padding-inline-start: 1.2rem;
  }

  .music__points div::before {
    content: '';
    position: absolute;
    inset-block-start: 0.6em;
    inset-inline-start: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .music__points dt {
    color: var(--fg);
    font-weight: var(--weight-medium);
  }

  .music__points dd {
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.95rem;
  }

  .music__link {
    margin-block-start: var(--space-6);
  }

  .music__visual :global(img) {
    border-color: var(--border-strong);
    border-radius: var(--radius);
  }

  @media (max-width: 968px) {
    .music {
      padding: var(--space-6);
      border-radius: var(--radius-lg);
    }
  }

  @media (max-width: 480px) {
    .music {
      padding: var(--space-5);
      border-radius: 20px;
    }
  }
</style>
