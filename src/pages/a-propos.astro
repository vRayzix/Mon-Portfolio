---
import ContactSection from '../components/ContactSection.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { href, site } from '../lib/site';

const skills = [
  {
    group: 'Systèmes',
    items: [
      'Linux : Debian, Ubuntu Server',
      'Services : systemd, Nginx, Caddy, Gunicorn, MariaDB',
      'Windows Server et Active Directory : utilisateurs, droits, GPO',
      'Docker',
    ],
  },
  {
    group: 'Réseau',
    items: [
      'Cisco IOS : VLAN, trunks 802.1Q, Spanning Tree',
      'Routage RIP et OSPF, NAT, DHCP, ACL',
      'Authentification 802.1X et RADIUS',
      'VPN WireGuard, pare-feu iptables et pfSense',
      'Émulation : GNS3, EVE-NG, Containerlab, CML',
    ],
  },
  {
    group: 'Supervision et sécurité',
    items: [
      'Prometheus, Node Exporter, Grafana',
      'SIEM Wazuh, CrowdSec',
      'Durcissement Linux, audit Lynis',
      'TLS automatique et challenge ACME DNS-01',
    ],
  },
  {
    group: 'Outils et méthode',
    items: [
      'Git et GitHub',
      'Python orienté objet, scripts PowerShell et Bash',
      'ServiceNow : gestion des incidents et des demandes',
      'Documentation technique en Markdown',
    ],
  },
];

const timeline = [
  {
    what: 'BUT Réseaux et Télécommunications',
    where: 'IUT de Colmar, Université de Haute-Alsace',
  },
  {
    what: 'Baccalauréat STI2D, spécialité Systèmes d’information et numérique',
    where: 'Lycée Camille Claudel, Blois',
  },
];
---

<BaseLayout
  title="À propos"
  description="Parcours, compétences et pratique de la sécurité de Lucas Carriat, étudiant en réseaux et télécommunications en recherche de stage en administration systèmes et réseaux."
>
  <header class="wrap page-header">
    <p class="eyebrow rise">Parcours et compétences</p>
    <h1 class="page-title rise">
      À propos de <span class="highlight">moi</span>
    </h1>
    <p class="page-lede rise rise-delay-1">
      Je m’appelle Lucas Carriat. J’étudie les réseaux et les télécommunications et je cherche un
      stage en administration systèmes et réseaux.
    </p>
  </header>

  <div class="wrap about">
    <section class="about__row glass reveal" aria-labelledby="recherche">
      <h2 id="recherche">Ce que je recherche</h2>
      <div class="about__content">
        <p>
          Un <strong>stage de 9 semaines</strong> en administration systèmes et réseaux,
          <strong>d’avril à juin 2027</strong>. J’aimerais rejoindre une équipe qui exploite une
          infrastructure réelle : parc Linux et Windows, réseau, supervision, sauvegardes. J’y
          apporterai de la rigueur et le réflexe de documenter ce que je fais. Je veux comprendre
          comment une infrastructure fonctionne au quotidien et y prendre part.
        </p>
        <p>
          Les projets qui montrent le mieux ma façon de travailler : le{' '}
          <a href={href('homelab/')}>homelab</a> et le{' '}
          <a href={href('projets/deploiement-django/')}>déploiement sur deux VM Debian</a>.
        </p>
      </div>
    </section>

    <section class="about__row glass reveal" aria-labelledby="competences">
      <h2 id="competences">Compétences techniques</h2>
      <div class="about__content skills">
        {skills.map((s) => (
          <div>
            <h3>{s.group}</h3>
            <ul class="list-reset">
              {s.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="about__row glass reveal" aria-labelledby="parcours">
      <h2 id="parcours">Parcours</h2>
      <ol class="about__content timeline list-reset">
        {timeline.map((t) => (
          <li>
            <p class="timeline__what">{t.what}</p>
            <p class="timeline__where">{t.where}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="about__row glass reveal" aria-labelledby="securite">
      <h2 id="securite">Pratique de la sécurité</h2>
      <div class="about__content">
        <p>
          <strong>CTF RhineTech, Mulhouse : 12ᵉ sur 39 équipes.</strong> Un challenge mêlant
          sécurité physique et numérique en temps limité : crochetage, énigmes logiques et intrusion
          sur des systèmes.
        </p>
        <p>
          Je m’entraîne régulièrement sur TryHackMe, Root-Me et Hack The Box : exploitation de
          vulnérabilités et élévation de privilèges. Comprendre l’attaque aide à mieux configurer et
          surveiller un système.
        </p>
      </div>
    </section>

    <section class="about__row glass reveal" aria-labelledby="autres">
      <h2 id="autres">Expériences</h2>
      <div class="about__content">
        <p>
          <strong>Tuteur méthodologique et disciplinaire, Learning Center de l’UHA.</strong> Poste
          étudiant rémunéré : j’accompagne des étudiants de première année en séances collectives
          sur les méthodes de travail, la compréhension des cours et la préparation des examens.
        </p>
        <p>
          <strong>Agent de restauration, CROUS de Strasbourg.</strong> Service et plonge en
          restauration universitaire : travail en équipe sous forte cadence et contact quotidien
          avec le public.
        </p>
        <p>
          <strong>Compositeur et producteur de musique indépendant, sur BeatStars.</strong> Gestion
          d’un catalogue de productions, ventes à l’international en anglais et en allemand,
          licences et contrats de droits d’auteur, promotion et analyse des ventes.
          <a href={site.beatstars}>Écouter sur BeatStars</a>.
        </p>
        <p>
          <strong>Olympiades de Sciences de l’Ingénieur, finaliste académique.</strong> Projet DYLO,
          une micro-hydrolienne : j’en ai conçu l’électronique et le programme Arduino de mesure de
          tension et de courant, avec affichage en temps réel.
        </p>
      </div>
    </section>

    <section class="about__row glass reveal" aria-labelledby="langues">
      <h2 id="langues">Langues</h2>
      <dl class="about__content langs">
        <div>
          <dt>Français</dt>
          <dd>langue maternelle</dd>
        </div>
        <div>
          <dt>Anglais</dt>
          <dd>B2+, opérationnel à l’oral</dd>
        </div>
        <div>
          <dt>Allemand</dt>
          <dd>A2</dd>
        </div>
      </dl>
    </section>

    <section class="about__contact" aria-labelledby="contact">
      <div class="section-head">
        <h2 class="section-title" id="contact">
          Me <span class="highlight">contacter</span>
        </h2>
      </div>
      <ContactSection />
    </section>
  </div>
</BaseLayout>

<style>
  .about {
    display: grid;
    gap: var(--space-6);
  }

  .about__row {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-7);
    border-radius: var(--radius-lg);
  }

  .about__contact {
    margin-block-start: var(--space-8);
  }

  @media (max-width: 480px) {
    .about__row {
      padding: var(--space-5);
      border-radius: 20px;
    }
  }

  @media (min-width: 810px) {
    .about__row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: var(--space-6);
    }
  }

  .about__row > h2 {
    color: var(--accent);
    font-size: 1.3rem;
    letter-spacing: 0;
  }

  .about__content {
    display: grid;
    gap: var(--space-5);
    max-width: var(--prose-w);
  }

  .about__content strong {
    color: var(--fg);
    font-weight: var(--weight-medium);
  }

  .about__content p,
  .about__content li,
  .about__content dd {
    color: var(--fg-muted);
  }

  .about__content a {
    color: var(--accent);
    text-decoration-color: rgb(255 204 0 / 0.4);
  }

  .skills {
    max-width: none;
    gap: var(--space-6);
  }

  @media (min-width: 810px) {
    .skills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .skills h3 {
    color: var(--fg);
    font-size: 1.05rem;
    font-weight: var(--weight-medium);
    letter-spacing: 0;
  }

  .skills ul {
    margin-block-start: var(--space-3);
    color: var(--fg-muted);
  }

  .skills li + li {
    margin-block-start: var(--space-2);
  }

  .timeline li + li {
    padding-block-start: var(--space-5);
    border-block-start: 1px solid var(--border-strong);
  }

  .timeline .timeline__where {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--accent);
  }

  .timeline .timeline__what {
    margin-block-end: var(--space-1);
    color: var(--fg);
    font-weight: var(--weight-medium);
  }

  .langs {
    gap: var(--space-3);
  }

  .langs div {
    display: flex;
    gap: var(--space-4);
  }

  .langs dt {
    min-width: 6rem;
    color: var(--fg);
    font-weight: var(--weight-medium);
  }

  .langs dd {
    margin: 0;
    color: var(--fg-muted);
  }
</style>
