---
import ApproachList from '../components/ApproachList.astro';
import ContactLinks from '../components/ContactLinks.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProjects } from '../lib/projects';
import { href } from '../lib/site';

const projects = await getProjects();
---

<BaseLayout>
  <section class="wrap hero" aria-labelledby="hero-title">
    <h1 class="hero__title rise" id="hero-title">
      Étudiant en réseaux et télécoms, futur analyste SOC.
    </h1>
    <p class="hero__lede rise rise-delay-1">
      Je cherche un stage de 9 semaines en administration systèmes et réseaux, d’avril à juin 2027.
    </p>
    <ul class="hero__links list-reset rise rise-delay-2">
      <li>
        <a href="#projets">Voir les projets</a>
      </li>
      <li>
        <a href="#contact">Me contacter</a>
      </li>
    </ul>
  </section>

  <section class="wrap section" id="projets" aria-labelledby="projets-title">
    <div class="section-head">
      <div>
        <h2 class="section-title" id="projets-title">
          Projets
        </h2>
        <p class="section-intro">Le homelab d’abord, puis trois études de cas.</p>
      </div>
      <a class="section-link" href={href('projets/')}>
        Tous les projets
      </a>
    </div>
    <ProjectGrid projects={projects} />
  </section>

  <section class="wrap section" id="apropos" aria-labelledby="apropos-title">
    <div class="section-head">
      <div>
        <h2 class="section-title" id="apropos-title">
          À propos
        </h2>
        <p class="section-intro">Qui je suis et ce que je vise.</p>
      </div>
      <a class="section-link" href={href('a-propos/')}>
        Parcours et compétences
      </a>
    </div>
    <div class="about">
      <p>
        Mon objectif est de devenir analyste SOC : surveiller, détecter et répondre aux incidents de
        sécurité. J’y vais en passant par l’administration systèmes et réseaux, parce qu’on
        surveille mieux une infrastructure qu’on sait faire tourner.
      </p>
      <p>
        En dehors des projets, je pratique la sécurité en compétition (CTF RhineTech, 12ᵉ sur 39
        équipes) et sur des plateformes d’entraînement.
      </p>
    </div>
  </section>

  <section class="wrap section" id="methode" aria-labelledby="approche-title">
    <div class="section-head">
      <div>
        <h2 class="section-title" id="approche-title">
          Ma façon de travailler
        </h2>
        <p class="section-intro">Quatre réflexes tirés de mes projets.</p>
      </div>
    </div>
    <ApproachList />
  </section>

  <section class="wrap section" id="contact" aria-labelledby="contact-title">
    <div class="section-head">
      <div>
        <h2 class="section-title" id="contact-title">
          Contact
        </h2>
      </div>
    </div>
    <ContactLinks />
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(var(--space-8), 12vw, var(--space-10)) var(--space-4);
  }

  .hero__title {
    max-width: 16ch;
    font-size: var(--step-4);
    font-weight: var(--weight-regular);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
  }

  .hero__lede {
    max-width: 46ch;
    margin-block-start: var(--space-6);
    font-size: var(--step-1);
    line-height: 1.45;
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    margin-block-start: var(--space-6);
  }

  .hero__links a {
    color: var(--fg);
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  .about {
    display: grid;
    gap: var(--space-5);
    max-width: 62ch;
    font-size: var(--step-1);
    line-height: 1.45;
  }
</style>
