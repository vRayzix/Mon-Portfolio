---
import { getEntry, render } from 'astro:content';
import HomelabArchitecture from '../components/diagram/HomelabArchitecture.astro';
import CaseStudyLayout from '../layouts/CaseStudyLayout.astro';

const project = await getEntry('projects', 'homelab');
if (!project) {
  throw new Error('Entrée « homelab » introuvable dans la collection projects');
}
const { Content, headings } = await render(project);
---

<CaseStudyLayout project={project} headings={headings}>
  <div class="wrap homelab-cover" slot="cover">
    <HomelabArchitecture id="hl-page" />
  </div>
  <Content />
</CaseStudyLayout>

<style>
  .homelab-cover {
    margin-block-end: var(--space-8);
  }
</style>
