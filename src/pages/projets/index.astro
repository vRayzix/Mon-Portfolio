---
import ProjectGrid from '../../components/ProjectGrid.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects } from '../../lib/projects';

const projects = await getProjects();
---

<BaseLayout
  title="Projets"
  description="Études de cas : homelab Linux supervisé et sécurisé, déploiement Django sur Debian, réseau Cisco multi-services, radio internet ESP32."
>
  <header class="wrap page-header">
    <p class="eyebrow rise">Études de cas</p>
    <h1 class="page-title rise">
      Mes <span class="highlight">projets</span>
    </h1>
    <p class="page-lede rise rise-delay-1">
      Chaque projet est présenté comme une étude de cas : le contexte, l’architecture, les choix
      techniques, les incidents rencontrés et le résultat.
    </p>
  </header>
  <section class="wrap" aria-label="Liste des projets">
    <ProjectGrid projects={projects} headingLevel="h2" />
  </section>
</BaseLayout>
